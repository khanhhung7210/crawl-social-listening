# Core
KEYWORD=Thỏ ơi
SYNC_INTERVAL_MIN=10
DB_URL=sqlite:///./data/social_listening.db
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787

# MongoDB
MONGO_HOST=10.10.17.18
MONGO_PORT=27017
MONGO_DB=CRM
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=CRM

# Optional Facebook scraper flow (ported from mr-konis-social-listening)
FACEBOOK_RAW_ENABLED=false
FACEBOOK_PAGE_URLS_FILE=
FACEBOOK_COOKIE=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v22.0

# Optional Facebook scraper flow (ported from mr-konis-social-listening)
FACEBOOK_SCRAPER_ENABLED=false
FACEBOOK_AXESSO_API_KEY=
# Chrome profile already logged into Facebook. Example on macOS:
# /Users/your-user/Library/Application Support/Google/Chrome
FACEBOOK_SEARCH_PROFILE_DIR=
FACEBOOK_SEARCH_SCROLL_SECONDS=20
FACEBOOK_COMMENT_LIMIT=50

# Optional Facebook Page API (Meta Graph)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_API_VERSION=v23.0
META_COMMENT_LIMIT=20

# Optional Threads API
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_VERSION=v1.0
THREADS_REPLY_LIMIT_PER_POST=100
THREADS_USE_KEYWORD_SEARCH=false
THREADS_SEARCH_TYPE=RECENT
THREADS_SEARCH_MODE=KEYWORD

# Optional Threads scraper flow (ported from mr-konis-social-listening)
THREADS_SCRAPER_TOKEN=

# Optional: limit per source
SOURCE_LIMIT=50
REDDIT_COMMENT_LIMIT_PER_POST=50
